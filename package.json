{
  "name": "@asigers/pi-knock",
  "version": "0.2.1",
  "description": "Remote notifications for Pi when a task finishes, fails, or needs your attention.",
  "type": "module",
  "license": "MIT",
  "author": "Asigers",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "notification",
    "ntfy",
    "pushover",
    "apple-watch",
    "remote-notification",
    "pi-web"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Asigers/pi-knock.git"
  },
  "homepage": "https://github.com/Asigers/pi-knock#readme",
  "bugs": {
    "url": "https://github.com/Asigers/pi-knock/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "pi-knock.example.json",
    "config.schema.json"
  ]
}
