{
  "name": "@asigers/pi-knock",
  "version": "0.3.2",
  "description": "Remote notifications for Pi when a task finishes, fails, or needs your attention.",
  "type": "module",
  "license": "MIT",
  "author": "Asigers",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "ai-coding-agent",
    "notification",
    "push-notifications",
    "remote-notification",
    "ntfy",
    "pushover",
    "apple-watch",
    "developer-tools",
    "pi-web"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Asigers/pi-knock.git"
  },
  "homepage": "https://github.com/Asigers/pi-knock#readme",
  "bugs": {
    "url": "https://github.com/Asigers/pi-knock/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Asigers/pi-knock/main/docs/assets/pi-knock-demo.gif"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc --outDir .test-dist --noEmit false --rewriteRelativeImportExtensions && node --test .test-dist/test/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE",
    "pi-knock.example.json",
    "config.schema.json"
  ]
}
